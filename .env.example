# ---------------------------------------------------------------------------
# FireClient website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Canonical public URL of the site (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL="https://fireclient.net"

# Public contact address shown on the support page
NEXT_PUBLIC_CONTACT_EMAIL="support@fireclient.net"

# ---------------------------------------------------------------------------
# Optional public links. Leave blank to render an honest "not published yet"
# state instead of a dead link. The UI degrades gracefully when these are unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# ---------------------------------------------------------------------------
# Support form delivery (server-only).
# The form POSTs to /api/support, which validates the payload and forwards it
# to this webhook (Slack/Discord webhook, Zapier, an email API, your own
# endpoint...). Without it, the endpoint returns a clear "not configured"
# error and the UI offers the contact email instead of pretending to send.
# ---------------------------------------------------------------------------
SUPPORT_WEBHOOK_URL=""
# Optional bearer token sent to the webhook
SUPPORT_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# Search engine verification (optional but recommended)
#
# Google Search Console → add property → "HTML tag" → copy ONLY the content
# value of the meta tag into NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION.
# Bing Webmaster Tools → add site → "Meta tag" → copy the msvalidate.01 value.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# IndexNow (Bing / Yandex / Naver instant indexing)
# Generate a key: https://www.bing.com/indexnow/getstarted
# 8–128 chars of a-z, A-Z, 0-9, "-". `npm run build` writes public/<key>.txt,
# and `npm run seo:indexnow` submits every sitemap URL after you deploy.
# ---------------------------------------------------------------------------
INDEXNOW_KEY=""
